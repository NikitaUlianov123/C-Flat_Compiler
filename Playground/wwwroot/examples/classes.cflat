// Classes have fields, constructors and methods.
class Cat
{
    string Name;
    int Lives;

    Cat(string name)
    {
        Name = name;
        Lives = 9;
    }

    void LoseLife()
    {
        Lives--;
    }

    int GetLives()
    {
        return Lives;
    }
}

Cat tom = new Cat("Tom");
print(tom.Name);

tom.LoseLife();
tom.LoseLife();
int left = tom.GetLives();
print(left);

// Fields can be changed from outside the class, too.
tom.Lives++;
print(tom.Lives);
