<?xml version="1.0" encoding="utf-8"?>
<!-- Default coverage settings: include only the Compiler assembly, exclude test project -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*Compiler\.dll$</ModulePath>
              </Include>
              <Exclude>
                <ModulePath>.*TestProject\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>
          </CodeCoverage>
          <Format>cobertura</Format>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
